# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Playwright's own generated output (traces, HTML report) -- not source.
frontend/test-results/
frontend/playwright-report/

# Local env overrides (frontend/.env.example is committed and stays tracked;
# this only excludes real local values someone creates from it).
.env
.env.local
.env.*.local

# Runtime-generated run output (not the curated example fixtures under backend/data/lines/).
# default_400_car_run is the one exception: committed on purpose so a fresh
# deploy (Render's filesystem doesn't persist between deploys) has it without
# a startup delay -- see the startup safety-net in api/app.py, which only
# regenerates it if it's somehow missing.
backend/data/runs/*
!backend/data/runs/default_400_car_run/
!backend/data/runs/default_400_car_run/**

# Trained models -- regenerate with scripts/train_risk_model.py. risk_v1 is
# committed on purpose: training takes several minutes (see README's Known
# limitations), far too heavy to ever run at boot, so a fresh deploy needs
# the trained artifact already present rather than trying to produce one.
backend/data/models/*
!backend/data/models/risk_v1/
!backend/data/models/risk_v1/**

# Internal working docs -- not part of what a project viewer needs; kept
# locally, deliberately not published on GitHub.
CLAUDE.md
DESIGN.md
NOTES-OVERNIGHT.md
.claude/reviewer.md
.claude/verify.md
screenshots/

# OS/editor
.DS_Store
