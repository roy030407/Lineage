# Copy to .env.local for local overrides (not committed), or set these as
# build-time environment variables in Vercel's project settings.
#
# Left unset, both fall back to relative paths / same-origin (today's local
# dev behavior via the Vite dev-server proxy in vite.config.ts) -- these are
# only needed for a split deployment where the frontend and backend are on
# different origins (e.g. Vercel + Render).

# REST API base URL, no trailing slash.
VITE_API_BASE_URL=https://lineage-backend.onrender.com

# Full ws(s):// URL for the line WebSocket.
VITE_WS_URL=wss://lineage-backend.onrender.com/ws/line
